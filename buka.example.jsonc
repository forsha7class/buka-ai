{
  // Copy this to `buka.jsonc` (this directory) or ~/.config/buka-ai/buka.jsonc
  // and edit. Project-level config is merged over the global one.
  //
  // A bare `buka` already works with these environment variables:
  //   OPENAI_API_KEY, OPENAI_BASE_URL

  "$schema": "https://raw.githubusercontent.com/.buka/config.json",

  // Run `buka setup` to build this section interactively. Keys entered there
  // live in ~/.config/buka-ai/secrets/<provider>.key (mode 0600), not here.
  //
  // "provider/modelKey" — only the FIRST slash separates the two.
  "model": "9router/davo",

  "providers": {
    "9router": {
      "name": "9Router",
      "type": "openai-compatible",
      "baseURL": "http://127.0.0.1:20128/v1",
      // Secrets support {env:VAR} and {file:/path/to/key}
      "apiKey": "{env:BUKA_9ROUTER_KEY}",
      // Pull the model list from the endpoint's /models instead of listing it.
      "discover": true,
      "models": {
        "davo": {
          // Wire id, when it differs from the key above.
          "id": "Davo",
          "name": "Davo (combo)",
          "tools": true,
          "reasoning": true,
          "input": ["text", "image"],
          "context": 1000000,
          "output": 128000
        }
      }
    },

    "openai": {
      "name": "OpenAI",
      "type": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "{env:OPENAI_API_KEY}",
      "discover": true,
      "models": {}
    }
  },

  // ask = prompt in the TUI · allow = run immediately · deny = refuse.
  // A tool with no entry here defaults to "ask", never to "run unattended".
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "ask",
    "write": "ask",
    "edit": "ask"
  },

  "tui": {
    // auto | dark | light | buka | opencode | hermes | classic
    "theme": "auto",
    // auto hides the sidebar on terminals narrower than 100 columns
    "sidebar": "auto",
    // spinner, mascot and activity animations
    "animations": true,
    // queue: Enter while the agent is running adds a message for the next turn
    "busyInput": "queue",
    "showThinking": true,
    "showTokenUsage": true
  }
}

// The system prompt is NOT configured here. It lives in its own file:
//   ~/.config/buka-ai/SYSTEM_PROMPT.md
// Edit that file and restart buka — no rebuild needed. Check what is actually
// sent with:  buka --show-prompt
